	"simulations": {
		"Real-time Video and Audio Chat in a Shared Room": {
			"name": "Real-time Video and Audio Chat in a Shared Room",
			"simSteps": [
				{
					"simStepId": "f0e9bdc8-ea80-46f3-a324-f9f20b733e13",
					"diagramNodeId": "ca644d8f-0f97-4229-ab1c-8acbf1325d7d",
					"simStepLabel": "User Joins Room & Accesses Media",
					"simStepDescription": "When a user navigates to a room, the `Room` component mounts. A `useEffect` hook initiates a connection to the Socket.IO server and requests access to the user's camera and microphone using `navigator.mediaDevices.getUserMedia`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "142",
						"endLine": "145",
						"relevantVariables": [
							"useEffect",
							"socketRef",
							"io.connect",
							"navigator.mediaDevices.getUserMedia"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"some-room-uuid\"\n}",
					"outputDataExample": "{\n  \"myStream\": \"[MediaStream object]\"\n}"
				},
				{
					"simStepId": "50d279c3-eb3a-4e8c-a2fd-d16984250a65",
					"diagramNodeId": "8b2a1a87-923c-4bc9-8f56-57ea95ae5213",
					"simStepLabel": "Client Emits 'join-room' Event",
					"simStepDescription": "After successfully obtaining the media stream, the client emits a 'join-room' event to the server, sending the room ID and its initial coordinates.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "147",
						"endLine": "147",
						"relevantVariables": [
							"socketRef.current.emit"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"some-room-uuid\",\n  \"initialCoordinates\": { \"x\": 450, \"y\": 600 }\n}",
					"outputDataExample": "{\n  \"roomID\": \"some-room-uuid\",\n  \"initialCoordinates\": { \"x\": 450, \"y\": 600 }\n}"
				},
				{
					"simStepId": "2fa54447-1f62-439c-99b7-af5e821857e5",
					"diagramNodeId": "f52153dc-fdbd-499c-8d1a-74deb1281e48",
					"simStepLabel": "Server Processes New User and Fetches Existing Users",
					"simStepDescription": "The server listens for the 'join-room' event. It adds the new user (identified by their socket ID) to the specified room and then filters the user list to find all other users already present in that room.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "14",
						"endLine": "32",
						"relevantVariables": [
							"io.on",
							"socket.on",
							"users",
							"socketToRoom",
							"usersInThisRoom"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"some-room-uuid\",\n  \"initialCoordinates\": { \"x\": 450, \"y\": 600 }\n}",
					"outputDataExample": "{\n  \"usersInThisRoom\": [\n    { \"id\": \"existing_socket_id_1\", \"coordinates\": { \"x\": 100, \"y\": 200 } }\n  ]\n}"
				},
				{
					"simStepId": "d8fe79f5-65a9-4a10-a5ad-127fd8098380",
					"diagramNodeId": "0416d167-f3af-4704-afb5-04e29937fc7d",
					"simStepLabel": "Server Emits 'existing-users' List",
					"simStepDescription": "The server sends the list of existing users back to the newly connected client via the 'existing-users' event. This allows the new client to know who to establish peer connections with.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "33",
						"endLine": "33",
						"relevantVariables": [
							"socket.emit"
						]
					},
					"inputDataExample": "{\n  \"usersInThisRoom\": [\n    { \"id\": \"existing_socket_id_1\", \"coordinates\": { \"x\": 100, \"y\": 200 } }\n  ]\n}",
					"outputDataExample": "{\n  \"usersInThisRoom\": [\n    { \"id\": \"existing_socket_id_1\", \"coordinates\": { \"x\": 100, \"y\": 200 } }\n  ]\n}"
				},
				{
					"simStepId": "cc6e0d01-9c6e-4325-9371-bb423bd7d530",
					"diagramNodeId": "351e24f1-f38c-494e-93d4-83bbdb5f53bb",
					"simStepLabel": "New User Creates WebRTC Offer",
					"simStepDescription": "The new user's client receives the 'existing-users' list. It iterates through this list and, for each existing user, creates a new `simple-peer` instance with `initiator: true`. This automatically generates a WebRTC offer signal.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "231",
						"endLine": "239",
						"relevantVariables": [
							"Peer",
							"initiator",
							"stream",
							"peer.on"
						]
					},
					"inputDataExample": "{\n  \"users\": [\n    { \"id\": \"existing_socket_id_1\", \"coordinates\": { \"x\": 100, \"y\": 200 } }\n  ]\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Offer SDP]\"\n}"
				},
				{
					"simStepId": "8e21a370-9672-4cc0-aab1-f6280cb63c7e",
					"diagramNodeId": "016eecee-ff4b-4e7f-a894-23b804c48a62",
					"simStepLabel": "Transmit WebRTC Offer to Server",
					"simStepDescription": "The `peer.on('signal')` event handler fires with the offer. The client then emits a 'stream-to-existing-users' event to the server, sending the offer signal and specifying which existing user should receive it.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "240",
						"endLine": "245",
						"relevantVariables": [
							"socketRef.current.emit"
						]
					},
					"inputDataExample": "{\n  \"existingUserID\": \"existing_socket_id_1\",\n  \"myID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"myCoordinates\": { \"x\": 450, \"y\": 600 }\n}",
					"outputDataExample": "{\n  \"existingUserID\": \"existing_socket_id_1\",\n  \"myID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"myCoordinates\": { \"x\": 450, \"y\": 600 }\n}"
				},
				{
					"simStepId": "a2da383d-ed85-4008-a936-697871fcca71",
					"diagramNodeId": "12f4b5b7-a9d3-472c-acb3-bb32f91ba91a",
					"simStepLabel": "Server Relays Offer Signal to Existing User",
					"simStepDescription": "The server listens for the 'stream-to-existing-users' event. It acts as a signaling server, forwarding the received WebRTC offer signal to the intended recipient (the existing user) via a 'user-joined' event.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "36",
						"endLine": "42",
						"relevantVariables": [
							"socket.on",
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\n  \"existingUserID\": \"existing_socket_id_1\",\n  \"myID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"myCoordinates\": { \"x\": 450, \"y\": 600 }\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"newUserID\": \"new_user_socket_id\",\n  \"coordinates\": { \"x\": 450, \"y\": 600 }\n}"
				},
				{
					"simStepId": "8833726e-6ab5-4439-99f8-819c89d1676c",
					"diagramNodeId": "fd0e8a45-7847-4bc6-8120-6b5e325a1c8f",
					"simStepLabel": "Transmit 'user-joined' Event with Offer",
					"simStepDescription": "The server sends the 'user-joined' event, containing the new user's ID and their WebRTC offer signal, directly to the socket of the existing user.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "37",
						"endLine": "41",
						"relevantVariables": [
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"newUserID\": \"new_user_socket_id\",\n  \"coordinates\": { \"x\": 450, \"y\": 600 }\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"newUserID\": \"new_user_socket_id\",\n  \"coordinates\": { \"x\": 450, \"y\": 600 }\n}"
				},
				{
					"simStepId": "9732f479-3c78-47e7-a28a-57dc98ed64b2",
					"diagramNodeId": "8d7ec6b7-698a-48d2-8228-0aed5e18c9fb",
					"simStepLabel": "Existing User Creates WebRTC Answer",
					"simStepDescription": "The existing user's client receives the 'user-joined' event. It creates a new `simple-peer` instance with `initiator: false`, passing in the offer signal it just received. This generates a WebRTC answer signal.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "256",
						"endLine": "262",
						"relevantVariables": [
							"Peer",
							"initiator",
							"stream"
						]
					},
					"inputDataExample": "{\n  \"signal\": \"[WebRTC Offer SDP]\",\n  \"newUserID\": \"new_user_socket_id\"\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Answer SDP]\"\n}"
				},
				{
					"simStepId": "2137a9d5-4d6a-4881-8a37-90aca03221be",
					"diagramNodeId": "6f40a5ef-5ce5-4f08-b38e-1187494ed644",
					"simStepLabel": "Transmit WebRTC Answer to Server",
					"simStepDescription": "The existing user's `peer.on('signal')` handler fires with the answer. The client emits a 'returning-signal-to-new-users' event, sending the answer signal to the server to be relayed back to the new user.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "44",
						"endLine": "52",
						"relevantVariables": [
							"socket.on('returning-signal-to-new-users')"
						]
					},
					"inputDataExample": "{\n  \"newUserID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Answer SDP]\"\n}",
					"outputDataExample": "{\n  \"newUserID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Answer SDP]\"\n}"
				},
				{
					"simStepId": "82a715e4-b101-42f5-8fc8-a2e23dc4c200",
					"diagramNodeId": "ba4b24a6-106f-4f88-abee-40128058aae1",
					"simStepLabel": "Server Relays Answer Signal to New User",
					"simStepDescription": "The server receives the 'returning-signal-to-new-users' event and relays the WebRTC answer signal to the new user (who initiated the connection) via a 'receiving-returned-signal-from-existing-user' event.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "44",
						"endLine": "52",
						"relevantVariables": [
							"socket.on",
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\n  \"newUserID\": \"new_user_socket_id\",\n  \"signal\": \"[WebRTC Answer SDP]\"\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Answer SDP]\",\n  \"id\": \"existing_socket_id_1\"\n}"
				},
				{
					"simStepId": "194c978b-1d67-4ddb-98cb-626f7bb72cea",
					"diagramNodeId": "3b03579f-011b-4efa-97f8-29f9514c3095",
					"simStepLabel": "Transmit 'receiving-returned-signal' with Answer",
					"simStepDescription": "The server sends the answer signal back to the new user, allowing them to complete the peer-to-peer connection handshake.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "45",
						"endLine": "51",
						"relevantVariables": [
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\n  \"signal\": \"[WebRTC Answer SDP]\",\n  \"id\": \"existing_socket_id_1\"\n}",
					"outputDataExample": "{\n  \"signal\": \"[WebRTC Answer SDP]\",\n  \"id\": \"existing_socket_id_1\"\n}"
				},
				{
					"simStepId": "707af7ae-48ac-404b-af06-e32dbf8ace76",
					"diagramNodeId": "bd248216-6f0a-4ead-8b4b-71e2a7cdd3cc",
					"simStepLabel": "Connection Finalized and Stream Attached",
					"simStepDescription": "The new user's client receives the answer signal and calls `peer.signal()` to finalize the connection. Once the connection is established, the `peer.on('stream')` event fires on both clients, and the received remote media stream is attached to a `<video>` element's `srcObject` property, making the video visible.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "109",
						"endLine": "113",
						"relevantVariables": [
							"useEffect",
							"props.peerObj.peer.on",
							"stream",
							"ref.current.srcObject"
						]
					},
					"inputDataExample": "{\n  \"signal\": \"[WebRTC Answer SDP]\"\n}",
					"outputDataExample": "{\n  \"stream\": \"[Remote MediaStream object]\"\n}"
				}
			],
			"description": "<ul><li>The core feature of the application is providing real-time, multi-party video and audio communication</li><li>It uses the browser's native WebRTC capabilities, abstracted by the 'simple-peer' library, to create direct peer-to-peer connections between users</li><li>The application requests access to the user's camera and microphone via 'navigator</li><li>mediaDevices</li><li>getUserMedia'</li><li>Media is then streamed directly to other participants in the same room, minimizing server load</li></ul>",
			"simulationNodesAndEdges": {
				"ca644d8f-0f97-4229-ab1c-8acbf1325d7d": {
