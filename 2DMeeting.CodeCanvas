			"cellName": "Generate Initial Coordinates - Room.js:L45-57",
			"cellId": "95a9f708-678a-4787-bbc1-d86439707990",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
