		"447c01c7-38c9-4d3b-8e74-13032cc3cf53": {
			"path": "447c01c7-38c9-4d3b-8e74-13032cc3cf53",
			"cellName": "Client Emits 'join-room' Event - Room.js:L149",
			"cellId": "447c01c7-38c9-4d3b-8e74-13032cc3cf53",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-1c4967d8-4eba-4fed-acca-54dbd0b6e7fa": {
			"path": "client/src/routes/Room.js-simstep-1c4967d8-4eba-4fed-acca-54dbd0b6e7fa",
			"fileName": "Room.js",
			"wiki": "The client uses its socket connection to emit a 'join-room' event, sending the payload containing the room ID and its initial coordinates to the server.",
			"cellName": "Client Emits 'join-room' Event - Room.js:L149",
			"cellId": "447c01c7-38c9-4d3b-8e74-13032cc3cf53",
			"visible": true,
			"startLine": 149,
			"endLine": 149,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"b8f2f53b-d15e-4e96-bf28-b22413ca22c9": {
			"path": "b8f2f53b-d15e-4e96-bf28-b22413ca22c9",
			"cellName": "Server Handles New User - server.js:L14-28",
			"cellId": "b8f2f53b-d15e-4e96-bf28-b22413ca22c9",
			"visible": true,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895"
		},
		"server.js-simstep-84f6dffe-b425-41ba-9e82-5db532b6d6e3": {
			"path": "server.js-simstep-84f6dffe-b425-41ba-9e82-5db532b6d6e3",
			"fileName": "server.js",
			"wiki": "The server receives the 'join-room' event. It extracts the coordinates, creates a new peer object with the unique socket ID and the received coordinates, and adds the user to the room's user list.",
			"cellName": "Server Handles New User - server.js:L14-28",
			"cellId": "b8f2f53b-d15e-4e96-bf28-b22413ca22c9",
			"visible": true,
			"startLine": 14,
			"endLine": 28,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895",
			"parentPath": "server.js"
		},
		"66e97eda-89a1-489b-858b-788b705cf37a": {
			"path": "66e97eda-89a1-489b-858b-788b705cf37a",
			"cellName": "Client Receives Welcome Package - Room.js:L150-156",
			"cellId": "66e97eda-89a1-489b-858b-788b705cf37a",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-7218b024-f8df-414b-b199-c0997c047eab": {
			"path": "client/src/routes/Room.js-simstep-7218b024-f8df-414b-b199-c0997c047eab",
			"fileName": "Room.js",
			"wiki": "The client receives the welcome package and updates its local state ('peer' state) with its unique ID and the coordinates confirmed by the server.",
			"cellName": "Client Receives Welcome Package - Room.js:L150-156",
			"cellId": "66e97eda-89a1-489b-858b-788b705cf37a",
			"visible": true,
			"startLine": 150,
			"endLine": 156,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"d3fae913-a10f-4f94-9d7c-61cc788b9fd1": {
			"path": "d3fae913-a10f-4f94-9d7c-61cc788b9fd1",
			"cellName": "Render User's Own Video Node - Room.js:L95-103",
			"cellId": "d3fae913-a10f-4f94-9d7c-61cc788b9fd1",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-31ffef4d-1297-4368-beb9-6a60121f55a8": {
			"path": "client/src/routes/Room.js-simstep-31ffef4d-1297-4368-beb9-6a60121f55a8",
			"fileName": "Room.js",
			"wiki": "The `MyVideo` component uses the passed-in coordinates to render a `StyledNode`. The `top` and `left` props of this styled component are set to the `y` and `x` values from the peer data, respectively.",
			"cellName": "Render User's Own Video Node - Room.js:L95-103",
			"cellId": "d3fae913-a10f-4f94-9d7c-61cc788b9fd1",
			"visible": true,
			"startLine": 95,
			"endLine": 103,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"8b93227b-34eb-4ebd-bd7c-d2ea9534f826": {
			"path": "8b93227b-34eb-4ebd-bd7c-d2ea9534f826",
			"cellName": "Server Forwards New User Info to Existing Users - server.js:L37-44",
			"cellId": "8b93227b-34eb-4ebd-bd7c-d2ea9534f826",
			"visible": true,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895"
		},
		"server.js-simstep-479853b2-fc57-4427-8d2d-d01ca4c72137": {
			"path": "server.js-simstep-479853b2-fc57-4427-8d2d-d01ca4c72137",
			"fileName": "server.js",
			"wiki": "As part of the WebRTC signaling process, the server receives a signal from the new user and forwards it to existing users in the room. Crucially, this payload includes the new user's coordinates.",
			"cellName": "Server Forwards New User Info to Existing Users - server.js:L37-44",
			"cellId": "8b93227b-34eb-4ebd-bd7c-d2ea9534f826",
			"visible": true,
			"startLine": 37,
			"endLine": 44,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895",
			"parentPath": "server.js"
		},
		"7e044ae4-fb35-4b62-af13-a0cb202bd6a6": {
			"path": "7e044ae4-fb35-4b62-af13-a0cb202bd6a6",
			"cellName": "Existing Client Handles New User - Room.js:L180-190",
			"cellId": "7e044ae4-fb35-4b62-af13-a0cb202bd6a6",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-f0a72313-9ad7-4f3a-b154-da5523697aae": {
			"path": "client/src/routes/Room.js-simstep-f0a72313-9ad7-4f3a-b154-da5523697aae",
			"fileName": "Room.js",
			"wiki": "An existing client receives the 'user-joined' event. It creates a new peer connection object for the new user, storing their coordinates within the peer's configuration.",
			"cellName": "Existing Client Handles New User - Room.js:L180-190",
			"cellId": "7e044ae4-fb35-4b62-af13-a0cb202bd6a6",
			"visible": true,
			"startLine": 180,
			"endLine": 190,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"fc7f6c8e-0a0f-485c-b900-cdd6e471c012": {
			"path": "fc7f6c8e-0a0f-485c-b900-cdd6e471c012",
			"cellName": "Render New User's Video Node - Room.js:L117-126",
			"cellId": "fc7f6c8e-0a0f-485c-b900-cdd6e471c012",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-8a19e14c-9c12-4436-872a-236685dc289a": {
			"path": "client/src/routes/Room.js-simstep-8a19e14c-9c12-4436-872a-236685dc289a",
			"fileName": "Room.js",
			"wiki": "The `Video` component renders a `StyledNode` for the new user. It accesses the coordinates from the nested `peer.config.coordinates` object and passes them as `top` and `left` props to position the video on the screen.",
			"cellName": "Render New User's Video Node - Room.js:L117-126",
			"cellId": "fc7f6c8e-0a0f-485c-b900-cdd6e471c012",
			"visible": true,
			"startLine": 117,
			"endLine": 126,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
