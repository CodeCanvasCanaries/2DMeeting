		"Create and Join Unique Meeting Rooms via URL": {
			"name": "Create and Join Unique Meeting Rooms via URL",
			"simSteps": [
				{
					"simStepId": "354d072b-5df1-4798-a0ff-44833d87a05a",
					"diagramNodeId": "441d18fe-b42a-4011-abab-37ae4f4158c1",
					"simStepLabel": "Initial Routing",
					"simStepDescription": "A user navigates to the root URL ('/'). The application's router, defined in App.js, matches this path and maps it to the 'CreateRoom' component.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/App.js",
						"startLine": "12",
						"endLine": "12",
