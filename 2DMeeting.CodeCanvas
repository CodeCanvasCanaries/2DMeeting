		"client/src/App.js-simstep-354d072b-5df1-4798-a0ff-44833d87a05a": {
			"path": "client/src/App.js-simstep-354d072b-5df1-4798-a0ff-44833d87a05a",
			"fileName": "App.js",
			"wiki": "A user navigates to the root URL ('/'). The application's router, defined in App.js, matches this path and maps it to the 'CreateRoom' component.",
			"cellName": "Initial Routing - App.js:L12",
			"cellId": "441d18fe-b42a-4011-abab-37ae4f4158c1",
			"visible": true,
			"startLine": 12,
			"endLine": 12,
			"parentCellId": "8dfe117f-f7b0-4825-a9d3-fbfc64496ddd",
