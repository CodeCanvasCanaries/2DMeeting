		"client/src/routes/Room.js-simstep-f0e9bdc8-ea80-46f3-a324-f9f20b733e13": {
			"path": "client/src/routes/Room.js-simstep-f0e9bdc8-ea80-46f3-a324-f9f20b733e13",
			"fileName": "Room.js",
			"wiki": "When a user navigates to a room, the `Room` component mounts. A `useEffect` hook initiates a connection to the Socket.IO server and requests access to the user's camera and microphone using `navigator.mediaDevices.getUserMedia`.",
			"cellName": "User Joins Room & Accesses Media - Room.js:L142-145",
			"cellId": "ca644d8f-0f97-4229-ab1c-8acbf1325d7d",
			"visible": true,
			"startLine": 142,
			"endLine": 145,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
