							"CreateRoom"
						]
					},
					"inputDataExample": "{\"url\": \"/\"}",
					"outputDataExample": "{\"componentToRender\": \"CreateRoom\"}"
				},
				{
					"simStepId": "cd1e74c4-154b-4ab1-a71b-7bd27d4e4256",
					"diagramNodeId": "006e8e39-dc7e-45fe-9983-98b357815510",
					"simStepLabel": "Render CreateRoom Component",
					"simStepDescription": "The routing decision triggers the rendering of the 'CreateRoom' component.",
