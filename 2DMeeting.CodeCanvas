					"diagramNodeId": "f4321a10-7816-477d-97af-28e62e478653",
					"simStepLabel": "Generate Unique Room ID and Redirect",
					"simStepDescription": "The 'CreateRoom' component executes. It generates a unique version 1 UUID and programmatically redirects the user's browser to a new URL path that includes this unique ID.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/CreateRoom.js",
						"startLine": "7",
						"endLine": "8",
						"relevantVariables": [
							"uuid",
							"id",
							"history.push"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"newPath\": \"/room/c2f4a7c0-4f5c-11ed-b878-0242ac120002\"}"
				},
				{
					"simStepId": "7817c80e-2a8c-4b35-b908-656f97bf2506",
					"diagramNodeId": "05eadb8a-2934-4165-bd1a-9eaa122a8b2c",
					"simStepLabel": "Browser URL Redirection",
					"simStepDescription": "The browser's URL is updated to the new path containing the unique room ID, triggering the router again.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/CreateRoom.js",
						"startLine": "8",
						"endLine": "8",
						"relevantVariables": [
							"history.push"
						]
