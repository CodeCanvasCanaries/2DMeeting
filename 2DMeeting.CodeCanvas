		"Dynamic Participant Discovery and Connection": {
			"name": "Dynamic Participant Discovery and Connection",
			"simSteps": [],
			"description": "<ul><li>The system dynamically manages connections as users enter a room</li><li>When a new user joins, the server sends them a list of 'existing-users' so they can initiate a connection with each one</li><li>Simultaneously, the server sends a 'user-joined' event to everyone already in the room, prompting them to establish a connection with the newcomer</li><li>This ensures all participants can see and hear each other</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "user-joined, existing-users, addPeer",
			"generationPrompt": "Dynamic Participant Discovery and Connection",
			"generationKeywords": "user-joined, existing-users, addPeer"
		},
		"Centralized Signaling for Peer-to-Peer Connections": {
			"name": "Centralized Signaling for Peer-to-Peer Connections",
			"simSteps": [],
			"description": "<ul><li>The Node</li><li>js server acts as a signaling server to orchestrate WebRTC connections, but does not handle the media streams itself</li><li>It uses 'socket</li><li>io' for real-time messaging</li><li>When clients need to connect, they exchange 'signal' data (like session descriptions and ICE candidates) through the server</li><li>The server routes these messages to the correct peers within a room, enabling them to establish a direct P2P connection</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "socket.io, signal, join-room",
			"generationPrompt": "Centralized Signaling for Peer-to-Peer Connections",
			"generationKeywords": "socket.io, signal, join-room"
		},
		"Move a Video Avatar in the 2D Space": {
			"name": "Move a Video Avatar in the 2D Space",
			"simSteps": [],
			"description": "<ul><li>This feature, while partially commented out in the client code, is a key intended part of the user experience</li><li>Users are meant to be able to click and drag their video node to a new position in the 2D space</li><li>The client would capture the new coordinates and emit an 'update-coordinates' event to the server</li><li>The server then broadcasts a 'user-moved' event to all other clients in the room, allowing them to see the user's avatar move in real-time</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "update-coordinates, user-moved, e.clientX",
			"generationPrompt": "Move a Video Avatar in the 2D Space",
			"generationKeywords": "update-coordinates, user-moved, e.clientX"
		},
		"Graceful Handling of User Disconnections": {
			"name": "Graceful Handling of User Disconnections",
			"simSteps": [],
			"description": "<ul><li>The application correctly handles cases where a user leaves the meeting</li><li>The server listens for a 'disconnect' event from each client's socket</li><li>When a user disconnects (e</li><li>g</li><li>, closes their browser), the server removes them from the room's roster and broadcasts a 'user-disconnected' message</li><li>This allows the remaining clients to remove the departed user's video stream and node, keeping the meeting state accurate</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "disconnect, user-disconnected, socketToRoom",
			"generationPrompt": "Graceful Handling of User Disconnections",
			"generationKeywords": "disconnect, user-disconnected, socketToRoom"
		}
	},
