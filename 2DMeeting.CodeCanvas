		"server.js-simstep-2fa54447-1f62-439c-99b7-af5e821857e5": {
			"path": "server.js-simstep-2fa54447-1f62-439c-99b7-af5e821857e5",
			"fileName": "server.js",
			"wiki": "The server listens for the 'join-room' event. It adds the new user (identified by their socket ID) to the specified room and then filters the user list to find all other users already present in that room.",
			"cellName": "Server Processes New User and Fetches Existing Users - server.js:L14-32",
			"cellId": "f52153dc-fdbd-499c-8d1a-74deb1281e48",
			"visible": true,
			"startLine": 14,
			"endLine": 32,
