			"path": "351e24f1-f38c-494e-93d4-83bbdb5f53bb",
			"cellName": "New User Creates WebRTC Offer - Room.js:L231-239",
			"cellId": "351e24f1-f38c-494e-93d4-83bbdb5f53bb",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-cc6e0d01-9c6e-4325-9371-bb423bd7d530": {
			"path": "client/src/routes/Room.js-simstep-cc6e0d01-9c6e-4325-9371-bb423bd7d530",
			"fileName": "Room.js",
			"wiki": "The new user's client receives the 'existing-users' list. It iterates through this list and, for each existing user, creates a new `simple-peer` instance with `initiator: true`. This automatically generates a WebRTC offer signal.",
			"cellName": "New User Creates WebRTC Offer - Room.js:L231-239",
			"cellId": "351e24f1-f38c-494e-93d4-83bbdb5f53bb",
			"visible": true,
			"startLine": 231,
			"endLine": 239,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"12f4b5b7-a9d3-472c-acb3-bb32f91ba91a": {
			"path": "12f4b5b7-a9d3-472c-acb3-bb32f91ba91a",
			"cellName": "Server Relays Offer Signal to Existing User - server.js:L36-42",
			"cellId": "12f4b5b7-a9d3-472c-acb3-bb32f91ba91a",
			"visible": true,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895"
		},
		"server.js-simstep-a2da383d-ed85-4008-a936-697871fcca71": {
			"path": "server.js-simstep-a2da383d-ed85-4008-a936-697871fcca71",
			"fileName": "server.js",
			"wiki": "The server listens for the 'stream-to-existing-users' event. It acts as a signaling server, forwarding the received WebRTC offer signal to the intended recipient (the existing user) via a 'user-joined' event.",
			"cellName": "Server Relays Offer Signal to Existing User - server.js:L36-42",
			"cellId": "12f4b5b7-a9d3-472c-acb3-bb32f91ba91a",
			"visible": true,
			"startLine": 36,
			"endLine": 42,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895",
			"parentPath": "server.js"
		},
		"8d7ec6b7-698a-48d2-8228-0aed5e18c9fb": {
			"path": "8d7ec6b7-698a-48d2-8228-0aed5e18c9fb",
			"cellName": "Existing User Creates WebRTC Answer - Room.js:L256-262",
			"cellId": "8d7ec6b7-698a-48d2-8228-0aed5e18c9fb",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-9732f479-3c78-47e7-a28a-57dc98ed64b2": {
			"path": "client/src/routes/Room.js-simstep-9732f479-3c78-47e7-a28a-57dc98ed64b2",
			"fileName": "Room.js",
			"wiki": "The existing user's client receives the 'user-joined' event. It creates a new `simple-peer` instance with `initiator: false`, passing in the offer signal it just received. This generates a WebRTC answer signal.",
			"cellName": "Existing User Creates WebRTC Answer - Room.js:L256-262",
			"cellId": "8d7ec6b7-698a-48d2-8228-0aed5e18c9fb",
			"visible": true,
			"startLine": 256,
			"endLine": 262,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"ba4b24a6-106f-4f88-abee-40128058aae1": {
			"path": "ba4b24a6-106f-4f88-abee-40128058aae1",
			"cellName": "Server Relays Answer Signal to New User - server.js:L44-52",
			"cellId": "ba4b24a6-106f-4f88-abee-40128058aae1",
			"visible": true,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895"
		},
		"server.js-simstep-82a715e4-b101-42f5-8fc8-a2e23dc4c200": {
			"path": "server.js-simstep-82a715e4-b101-42f5-8fc8-a2e23dc4c200",
			"fileName": "server.js",
			"wiki": "The server receives the 'returning-signal-to-new-users' event and relays the WebRTC answer signal to the new user (who initiated the connection) via a 'receiving-returned-signal-from-existing-user' event.",
			"cellName": "Server Relays Answer Signal to New User - server.js:L44-52",
			"cellId": "ba4b24a6-106f-4f88-abee-40128058aae1",
			"visible": true,
			"startLine": 44,
			"endLine": 52,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895",
			"parentPath": "server.js"
		},
		"bd248216-6f0a-4ead-8b4b-71e2a7cdd3cc": {
			"path": "bd248216-6f0a-4ead-8b4b-71e2a7cdd3cc",
			"cellName": "Connection Finalized and Stream Attached - Room.js:L109-113",
			"cellId": "bd248216-6f0a-4ead-8b4b-71e2a7cdd3cc",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-707af7ae-48ac-404b-af06-e32dbf8ace76": {
			"path": "client/src/routes/Room.js-simstep-707af7ae-48ac-404b-af06-e32dbf8ace76",
			"fileName": "Room.js",
			"wiki": "The new user's client receives the answer signal and calls `peer.signal()` to finalize the connection. Once the connection is established, the `peer.on('stream')` event fires on both clients, and the received remote media stream is attached to a `<video>` element's `srcObject` property, making the video visible.",
			"cellName": "Connection Finalized and Stream Attached - Room.js:L109-113",
			"cellId": "bd248216-6f0a-4ead-8b4b-71e2a7cdd3cc",
			"visible": true,
			"startLine": 109,
			"endLine": 113,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"8b2a1a87-923c-4bc9-8f56-57ea95ae5213": {
			"path": "8b2a1a87-923c-4bc9-8f56-57ea95ae5213",
