		},
		"f4321a10-7816-477d-97af-28e62e478653": {
			"path": "f4321a10-7816-477d-97af-28e62e478653",
			"cellName": "Generate Unique Room ID and Redirect - CreateRoom.js:L7-8",
			"cellId": "f4321a10-7816-477d-97af-28e62e478653",
			"visible": true,
			"parentCellId": "b0decc31-2785-4b7d-b243-7101704d88ff"
		},
		"client/src/routes/CreateRoom.js-simstep-a80e975e-ce74-4652-bae4-d32eec787136": {
			"path": "client/src/routes/CreateRoom.js-simstep-a80e975e-ce74-4652-bae4-d32eec787136",
			"fileName": "CreateRoom.js",
			"wiki": "The 'CreateRoom' component executes. It generates a unique version 1 UUID and programmatically redirects the user's browser to a new URL path that includes this unique ID.",
			"cellName": "Generate Unique Room ID and Redirect - CreateRoom.js:L7-8",
			"cellId": "f4321a10-7816-477d-97af-28e62e478653",
			"visible": true,
			"startLine": 7,
			"endLine": 8,
			"parentCellId": "b0decc31-2785-4b7d-b243-7101704d88ff",
			"parentPath": "client/src/routes/CreateRoom.js"
		},
		"06605270-b277-44c2-831a-0dbbc51fb742": {
			"path": "06605270-b277-44c2-831a-0dbbc51fb742",
			"cellName": "Route to Room Component - App.js:L13",
			"cellId": "06605270-b277-44c2-831a-0dbbc51fb742",
			"visible": true,
			"parentCellId": "8dfe117f-f7b0-4825-a9d3-fbfc64496ddd"
		},
		"client/src/App.js-simstep-9a525bbe-2784-4edf-b7b3-14f35033a4ff": {
			"path": "client/src/App.js-simstep-9a525bbe-2784-4edf-b7b3-14f35033a4ff",
			"fileName": "App.js",
			"wiki": "The application's router matches the new URL pattern ('/room/:roomID') and maps it to the 'Room' component.",
			"cellName": "Route to Room Component - App.js:L13",
			"cellId": "06605270-b277-44c2-831a-0dbbc51fb742",
			"visible": true,
			"startLine": 13,
			"endLine": 13,
			"parentCellId": "8dfe117f-f7b0-4825-a9d3-fbfc64496ddd",
			"parentPath": "client/src/App.js"
		},
		"2cd6321f-f8dc-4060-89b1-0776a879a6b3": {
			"path": "2cd6321f-f8dc-4060-89b1-0776a879a6b3",
			"cellName": "Client Joins Room via WebSocket - Room.js:L142-146",
			"cellId": "2cd6321f-f8dc-4060-89b1-0776a879a6b3",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-8d2dae47-f954-49cc-9024-bfbcc1645f45": {
			"path": "client/src/routes/Room.js-simstep-8d2dae47-f954-49cc-9024-bfbcc1645f45",
			"fileName": "Room.js",
			"wiki": "Inside the 'Room' component's 'useEffect' hook, the client establishes a WebSocket connection to the server. It then emits a 'join-room' event, sending its generated 'roomID' and initial coordinates.",
			"cellName": "Client Joins Room via WebSocket - Room.js:L142-146",
			"cellId": "2cd6321f-f8dc-4060-89b1-0776a879a6b3",
			"visible": true,
			"startLine": 142,
			"endLine": 146,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"1a069e48-7f10-410f-ba7d-e24cd1cfce46": {
			"path": "1a069e48-7f10-410f-ba7d-e24cd1cfce46",
			"cellName": "Server Handles Join Room - server.js:L14-34",
			"cellId": "1a069e48-7f10-410f-ba7d-e24cd1cfce46",
			"visible": true,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895"
		},
		"server.js-simstep-1b48c019-11c6-457b-80ee-6e26d04fa987": {
			"path": "server.js-simstep-1b48c019-11c6-457b-80ee-6e26d04fa987",
			"fileName": "server.js",
			"wiki": "The server receives the 'join-room' event. It adds the new user (identified by their socket ID) to the specified room's roster. If the room doesn't exist, it's created. It then prepares to send information back to the newly connected client.",
			"cellName": "Server Handles Join Room - server.js:L14-34",
			"cellId": "1a069e48-7f10-410f-ba7d-e24cd1cfce46",
			"visible": true,
			"startLine": 14,
			"endLine": 34,
			"parentCellId": "c6de7a53-cdd0-4086-b7a5-2a01175ae895",
			"parentPath": "server.js"
		},
		"703ad67b-0499-4771-ad07-6df364adabf4": {
			"path": "703ad67b-0499-4771-ad07-6df364adabf4",
			"cellName": "Client Receives Welcome Package - Room.js:L147-154",
			"cellId": "703ad67b-0499-4771-ad07-6df364adabf4",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-ff4070b7-dc3e-4d56-82c3-2a97ab15e1b0": {
			"path": "client/src/routes/Room.js-simstep-ff4070b7-dc3e-4d56-82c3-2a97ab15e1b0",
			"fileName": "Room.js",
			"wiki": "The client's event listener for 'your-welcome-package' fires, receiving its own peer information. This data is then used to set the local peer state.",
			"cellName": "Client Receives Welcome Package - Room.js:L147-154",
			"cellId": "703ad67b-0499-4771-ad07-6df364adabf4",
			"visible": true,
			"startLine": 147,
			"endLine": 154,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61",
			"parentPath": "client/src/routes/Room.js"
		},
		"0bd8804e-e2ed-4bc9-82b4-b2cf26768548": {
			"path": "0bd8804e-e2ed-4bc9-82b4-b2cf26768548",
			"cellName": "Client Receives Existing Users - Room.js:L156-169",
			"cellId": "0bd8804e-e2ed-4bc9-82b4-b2cf26768548",
			"visible": true,
			"parentCellId": "8c28165a-18d3-41f3-8e99-d7ec59478c61"
		},
		"client/src/routes/Room.js-simstep-307591d2-c55d-402e-ba16-197f6ce5391a": {
			"path": "client/src/routes/Room.js-simstep-307591d2-c55d-402e-ba16-197f6ce5391a",
			"fileName": "Room.js",
			"wiki": "The client's event listener for 'existing-users' fires. It iterates through the list of existing users and initiates peer-to-peer connections with each of them.",
			"cellName": "Client Receives Existing Users - Room.js:L156-169",
